---
import type { Agent } from '../lib/contracts';
import { profilePath } from '../lib/contracts';
import ExternalLink from './ExternalLink.astro';
interface Props {
  agent: Agent;
}
const { agent } = Astro.props;
---

<aside class="feature-card">
  <div class="identity">
    <div class="monogram" aria-hidden="true">
      {agent.initials}
    </div>
    <div>
      <h3>{agent.name}</h3>
      <div class="brokerage">{agent.brokerage}</div>
    </div>
  </div>
  <p>{agent.short}</p>
  <a class="btn btn-gold" href={profilePath(agent)}>
    See why we chose them
  </a>
  <p class="note">
    <ExternalLink href={agent.har}>View the HAR profile</ExternalLink>
  </p>
</aside>
