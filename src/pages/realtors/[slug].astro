---
import type { GetStaticPaths } from 'astro';
import type { Agent, Rating } from '../../lib/contracts';
import {
  FACTS_CHECKED,
  SPONSORED_SLUG,
  profilePath,
} from '../../lib/contracts';
import { getDirectory, profileSchema } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import RatingPanel from '../../components/Rating.astro';
export const getStaticPaths = (async () => {
  const { agents, ratings } = await getDirectory();
  return agents.map((agent) => ({
    params: { slug: agent.slug },
    props: {
      agent,
      rating: ratings[agent.slug],
      related: agents.filter((a) => a.slug !== agent.slug),
    },
  }));
}) satisfies GetStaticPaths;
interface Props {
  agent: Agent;
  rating?: Rating;
  related: Agent[];
}
const { agent, rating, related } = Astro.props;
const highlights = agent.highlights;
const checked = agent.checked ?? FACTS_CHECKED;
const licenseNote = agent.license
  ? 'License numbers on this page are attributed to HAR, not a live TREC status check. '
  : '';
---

<Base
  title={`${agent.name} | Top Realtors Cypress TX`}
  description={agent.intro}
  path={profilePath(agent)}
  schema={profileSchema(agent)}
>
  <main id="main">
    <section class="profile-hero">
      <div class="wrap">
        <div class="breadcrumb">
          <a href="/">Home</a> / <a href="/#directory">Directory</a> /{' '}
          {agent.name}
        </div>
        <div class="profile-grid">
          <div>
            <span class="eyebrow">{agent.type} · Cypress, TX</span>
            <h1>{agent.name}</h1>
            <div class="brokerage">{agent.brokerage}</div>
            <p class="lede">{agent.intro}</p>
            <div class="hero-actions">
              <ExternalLink
                href={agent.official}
                class="btn btn-gold"
                paid={agent.slug === SPONSORED_SLUG}
              >
                {agent.official_label ?? 'Visit official website'}
              </ExternalLink>
              <ExternalLink href={agent.har} class="text-link">
                View HAR profile
              </ExternalLink>
            </div>
          </div>
          <aside class="profile-aside" aria-label="Professional details">
            <div class="monogram" aria-hidden="true">
              {agent.initials}
            </div>
            <span class="eyebrow">At a glance</span>
            <dl>
              <div>
                <dt>Brokerage</dt>
                <dd>{agent.brokerage}</dd>
              </div>
              <div>
                <dt>Profile type</dt>
                <dd>{agent.type}</dd>
              </div>
              {highlights?.experience && (
                <div>
                  <dt>Experience</dt>
                  <dd>{highlights.experience}</dd>
                </div>
              )}
              {highlights?.team && (
                <div>
                  <dt>Team</dt>
                  <dd>{highlights.team}</dd>
                </div>
              )}
              {highlights && highlights.languages.length > 0 && (
                <div>
                  <dt>Languages</dt>
                  <dd>{highlights.languages.join(', ')}</dd>
                </div>
              )}
              {agent.license && (
                <div>
                  <dt>License number listed by HAR</dt>
                  <dd>{agent.license}</dd>
                </div>
              )}
              {agent.phone && (
                <div>
                  <dt>Public business phone</dt>
                  <dd>
                    <a href={`tel:${agent.tel}`}>{agent.phone}</a>
                  </dd>
                </div>
              )}
            </dl>
            <ExternalLink href={agent.har} class="btn btn-light">
              See current HAR listings
            </ExternalLink>
            <p class="note">
              {licenseNote}We checked these sources {checked}.
            </p>
          </aside>
        </div>
      </div>
    </section>
    <section class="section">
      <div class="wrap">
        <RatingPanel agent={agent} rating={rating} />
      </div>
      <div class="wrap profile-content">
        <div>
          <span class="eyebrow">What we found</span>
          <h2>
            What buyers and sellers <em>should know.</em>
          </h2>
          {highlights && (
            <dl class="highlights">
              {highlights.specialties.length > 0 && (
                <div>
                  <dt>Specialties</dt>
                  <dd>{highlights.specialties.join(' · ')}</dd>
                </div>
              )}
              {highlights.areas.length > 0 && (
                <div>
                  <dt>Areas served</dt>
                  <dd>{highlights.areas.join(' · ')}</dd>
                </div>
              )}
              {highlights.designations.length > 0 && (
                <div>
                  <dt>Designations</dt>
                  <dd>{highlights.designations.join(' · ')}</dd>
                </div>
              )}
              {highlights.reviews && (
                <div>
                  <dt>What recent clients say</dt>
                  <dd>{highlights.reviews}</dd>
                </div>
              )}
            </dl>
          )}
          <ul class="fact-list">
            {agent.facts.map((fact) => (
              <li>
                {fact.text}
                <small>
                  Source:{' '}
                  <ExternalLink href={agent.sources[fact.source].url}>
                    {agent.sources[fact.source].label}
                  </ExternalLink>
                </small>
              </li>
            ))}
          </ul>
          <div class="profile-questions">
            <h3>Questions we’d ask on the first call.</h3>
            <ul>
              <li>
                What have you sold or leased recently near the homes I’m
                considering?
              </li>
              <li>
                Who will be my day-to-day contact, and how often will we talk?
              </li>
              <li>
                What will you charge, what’s included, and what will I sign?
              </li>
            </ul>
          </div>
        </div>
        <aside class="sources">
          <h2>Our sources</h2>
          <ol>
            {agent.sources.map((source) => (
              <li>
                <ExternalLink href={source.url}>{source.label}</ExternalLink>
                <br />
                <span class="note">{source.supports}</span>
              </li>
            ))}
          </ol>
          <p>
            We read these public HAR pages and the realtor’s own website. They
            are not audited performance records. HAR ratings are labeled with
            the individual they belong to, and we don’t rank performance or give
            team-wide scores.
          </p>
          <p>
            Checked {checked}. {licenseNote}To confirm a current license, use{' '}
            <ExternalLink href="https://www.trec.texas.gov/license-search/">
              TREC’s License Holder Search
            </ExternalLink>
            .
          </p>
        </aside>
      </div>
    </section>
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <span class="eyebrow">Keep comparing</span>
        <h2>
          Meet the other <em>realtors.</em>
        </h2>
        <div class="more-links">
          {related.map((other) => (
            <a href={profilePath(other)}>{other.name}</a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Base>
