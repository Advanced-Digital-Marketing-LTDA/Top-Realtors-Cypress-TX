---
import Base from '../layouts/Base.astro';
import Featured from '../components/Featured.astro';
import AgentRow from '../components/AgentRow.astro';
import { getDirectory, directorySchema } from '../lib/content';
import {
  SPONSORED_SLUG,
  NEIGHBORHOODS,
  neighborhoodPath,
  profilePath,
  servesNeighborhood,
} from '../lib/contracts';
import ExternalLink from '../components/ExternalLink.astro';
const { agents, ratings } = await getDirectory();
const team = agents.find((agent) => agent.slug === SPONSORED_SLUG)!;
const faq = [
  {
    question: 'Is this a ranking of the best realtors?',
    answer:
      'No. The Lippincott Team is our #1 choice, which is an editorial recommendation, not a calculated ranking. Everyone else is listed alphabetically. HAR ratings belong to the named individual, may not cover a whole team or only Cypress sales, and don’t decide the order.',
  },
  {
    question: 'What did you actually check?',
    answer:
      'We read each realtor’s HAR profile, sales and lease history, public client comments and website for specialties, service areas, credentials and recent activity. Some details are self-reported, and we say so. We did not audit sales, reviews or local knowledge.',
  },
  {
    question: 'How current is the information?',
    answer:
      'We checked our sources on October 14 and 15, 2026. Each rating shows its own check date. Pages don’t update automatically, so confirm a realtor’s brokerage, license, services and availability with them before you rely on it.',
  },
  {
    question: 'How do I contact a realtor?',
    answer:
      'Use the website link or the public business phone on each profile. We don’t collect or forward inquiries, and we don’t set anyone’s fees, so confirm terms with the realtor directly.',
  },
  {
    question: 'Do you collect my contact details?',
    answer:
      'No. There are no forms, sign-ups or lead capture here, and we load no analytics or third-party fonts. Links to other sites follow their own privacy practices.',
    id: 'privacy',
  },
];
const places = NEIGHBORHOODS.map((place) => ({
  ...place,
  count: agents.filter((agent) => servesNeighborhood(agent, place)).length,
}));
---

<Base
  title={`Cypress TX Realtors Compared: ${agents.length} Agents, Reviews & Sales`}
  description={`Compare ${agents.length} Cypress, TX realtors and teams side by side: specialties, neighborhoods served, HAR client ratings and recent sales, with a source for each fact.`}
  path="/"
  schema={directorySchema(agents, faq)}
>
  <main id="main">
    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <span class="eyebrow">
              Cypress, Texas · {agents.length} realtor profiles
            </span>
            <h1>
              Compare Cypress, TX realtors.
              <br />
              Find your <em>right fit.</em>
            </h1>
            <p class="lede">
              We read the HAR records, client reviews and websites of{' '}
              {agents.length} Cypress, TX agents and teams. Each profile covers
              who they help, where they work, what they’ve sold and what clients
              say, with a link to every source.
            </p>
            <div class="hero-actions">
              <a class="btn btn-gold" href="#directory">
                Compare the realtors
              </a>
              <a class="text-link" href="#methodology">
                How we check our facts
              </a>
            </div>
          </div>
          <Featured agent={team} />
        </div>
        <figure class="hero-photo">
          <picture>
            <source
              type="image/avif"
              srcset="/assets/coles-crossing-morning-660.avif 660w, /assets/coles-crossing-morning-1320.avif 1320w, /assets/coles-crossing-morning-2640.avif 2640w"
              sizes="(max-width: 800px) calc(100vw - 40px), (max-width: 1150px) calc(100vw - 64px), (max-width: 1416px) calc(100vw - 96px), 1320px"
            />
            <source
              type="image/webp"
              srcset="/assets/coles-crossing-morning-660.webp 660w, /assets/coles-crossing-morning-1320.webp 1320w, /assets/coles-crossing-morning-2640.webp 2640w"
              sizes="(max-width: 800px) calc(100vw - 40px), (max-width: 1150px) calc(100vw - 64px), (max-width: 1416px) calc(100vw - 96px), 1320px"
            />
            <img
              src="/assets/coles-crossing-morning-1320.jpg"
              srcset="/assets/coles-crossing-morning-660.jpg 660w, /assets/coles-crossing-morning-1320.jpg 1320w, /assets/coles-crossing-morning-2640.jpg 2640w"
              sizes="(max-width: 800px) calc(100vw - 40px), (max-width: 1150px) calc(100vw - 64px), (max-width: 1416px) calc(100vw - 96px), 1320px"
              alt="Morning sunlight through mature trees beside the road at the western entrance to Coles Crossing in Cypress, Texas"
              width="4102"
              height="2328"
              fetchpriority="high"
            />
          </picture>
          <figcaption>
            <span>Coles Crossing, Cypress · Archival photograph, May 2014</span>
            <span>
              <a
                href="https://commons.wikimedia.org/wiki/File:May_Morning_-_Flickr_-_pinemikey.jpg"
                target="_blank"
                rel="noopener noreferrer"
                class=""
              >
                Photo: Michael Martin
              </a>{' '}
              ·{' '}
              <a
                href="https://creativecommons.org/licenses/by-sa/2.0/"
                target="_blank"
                rel="noopener noreferrer"
                class=""
              >
                CC BY-SA 2.0
              </a>{' '}
              · Cropped for display
            </span>
          </figcaption>
        </figure>
        <div class="index-strip">
          <div>
            <b>{String(agents.length).padStart(2, '0')}</b>
            <span>
              Realtor profiles
              <br />
              with linked sources
            </span>
          </div>
          <div>
            <b>05</b>
            <span>
              Cypress communities
              <br />
              to start exploring
            </span>
          </div>
          <div>
            <b>01</b>
            <span>
              Editorial pick:
              <br />
              The Lippincott Team
            </span>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="directory">
      <div class="wrap">
        <div class="section-intro">
          <div>
            <span class="eyebrow">
              The directory · Our #1 choice, then A to Z
            </span>
            <h2>
              Meet the realtors.
              <br />
              Shortlist your <em>favorites.</em>
            </h2>
          </div>
          <p>
            Start with our featured pick, then browse everyone else A to Z. Each
            profile lists specialties, areas served, recent sales and client
            comments, with sources.
          </p>
        </div>
        {agents.map((agent) => (
          <AgentRow agent={agent} rating={ratings[agent.slug]} />
        ))}
      </div>
    </section>
    <section class="section compare" id="compare" style="padding-top:0">
      <div class="wrap">
        <span class="eyebrow">At a glance</span>
        <h2>
          Compare them <em>side by side.</em>
        </h2>
        <div
          class="compare-scroll"
          role="region"
          aria-label="Realtor comparison table"
          tabindex="0"
        >
          <table class="compare-table">
            <caption>
              {`${agents.length} Cypress, TX realtors compared. HAR ratings belong to the named individual and don’t decide the order.`}
            </caption>
            <thead>
              <tr>
                <th scope="col">Realtor</th>
                <th scope="col">Type</th>
                <th scope="col">Brokerage</th>
                <th scope="col">Specialties</th>
                <th scope="col">HAR client rating</th>
              </tr>
            </thead>
            <tbody>
              {agents.map((agent) => {
                const rating = ratings[agent.slug];
                return (
                  <tr data-profile={agent.slug}>
                    <th scope="row">
                      <a href={profilePath(agent)}>{agent.name}</a>
                    </th>
                    <td>{agent.type}</td>
                    <td>{agent.brokerage}</td>
                    <td>
                      {(agent.highlights?.specialties ?? [])
                        .slice(0, 3)
                        .join(', ') || 'See profile'}
                    </td>
                    <td>
                      {rating ? (
                        <>
                          {rating.value} / 5 ({rating.subject}, {rating.count}{' '}
                          {rating.count_type})
                          <br />
                          <span class="note">
                            <ExternalLink href={rating.source}>
                              {rating.platform}
                            </ExternalLink>{' '}
                            · Checked{' '}
                            <time datetime={rating.checked}>
                              {rating.checked}
                            </time>
                            . {rating.scope}.
                          </span>
                        </>
                      ) : (
                        'No HAR rating in this snapshot'
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </section>
    <section class="section dark" id="methodology">
      <div class="wrap">
        <span class="eyebrow">How we check facts</span>
        <h2>
          We only publish what
          <br />
          <em>we can link to.</em>
        </h2>
        <div class="method-grid">
          <article>
            <span class="step">01 / LINK EVERY FACT</span>
            <h3>We show where it came from.</h3>
            <p>
              Every fact on a profile carries a link to the HAR page or website
              we read it on, so you can check it yourself.
            </p>
          </article>
          <article>
            <span class="step">02 / LEAVE OUT GUESSWORK</span>
            <h3>We label what’s self-reported.</h3>
            <p>
              HAR ratings show whose rating it is, how many surveys and when we
              checked. Awards and totals a realtor publishes about themselves
              are marked as self-reported. If we can’t verify something, we
              leave it out.
            </p>
          </article>
          <article>
            <span class="step">03 / CONFIRM BEFORE YOU SIGN</span>
            <h3>Ask before you commit.</h3>
            <p>
              Listings and rosters change. Confirm licensing, brokerage,
              services, fees and availability with the realtor, and check
              licenses with TREC.
            </p>
          </article>
        </div>
        <p class="method-note">
          We reviewed HAR profiles, public client comments and each linked
          website on October 14 and 15, 2026. We did not interview the realtors,
          hire them, audit every review or score their performance. Use these
          profiles to build your shortlist, then talk to the people on it.
        </p>
      </div>
    </section>
    <section class="section" id="neighborhoods">
      <div class="wrap">
        <div class="section-intro">
          <div>
            <span class="eyebrow">Five places to get oriented</span>
            <h2>
              Start with the <em>neighborhood.</em>
            </h2>
          </div>
          <p>
            These official community and association sites are where we’d start.
            Check school zoning, taxes, MUD fees and deed restrictions for the
            specific home you’re considering.
          </p>
        </div>
        <div class="hood-grid">
          {places.map((place) => (
            <article class="hood-card" data-place={place.slug}>
              <span class="eyebrow">{place.eyebrow}</span>
              <h3>{place.name}</h3>
              <p>{place.summary}</p>
              <div class="hood-links">
                <a class="text-link" href={neighborhoodPath(place)}>
                  {place.count} realtors who serve {place.name}
                </a>
                <ExternalLink href={place.official} class="text-link">
                  {place.officialLabel}
                </ExternalLink>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <span class="eyebrow">Before the first call</span>
        <h2>
          Questions we’d <em>ask first.</em>
        </h2>
        <div class="question-grid">
          <article class="question-box">
            <span class="tag">If you’re selling</span>
            <h3>
              Get specific about
              <br />
              the plan for <em>your home.</em>
            </h3>
            <ul>
              <li>
                Which comparable sales would you use to discuss a list price?
              </li>
              <li>
                What marketing, photography, and showing services are included?
              </li>
              <li>
                How will we review buyer feedback and decide whether to adjust?
              </li>
            </ul>
          </article>
          <article class="question-box">
            <span class="tag">If you’re buying</span>
            <h3>
              Understand the process
              <br />
              before you <em>fall in love.</em>
            </h3>
            <ul>
              <li>
                What have you sold recently in the neighborhoods I’m
                considering?
              </li>
              <li>
                How will we check this home’s tax rate, MUD fees and deed
                restrictions?
              </li>
              <li>
                What does your buyer agreement say about your compensation, and
                who pays it?
              </li>
            </ul>
          </article>
        </div>
      </div>
    </section>
    <section class="section faq" id="faq">
      <div class="wrap">
        <span class="eyebrow">Common questions</span>
        <h2>
          What you might <em>be wondering.</em>
        </h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details id={item.id}>
              <summary>{item.question}</summary>
              <p>
                {item.answer}
                {item.id === 'privacy' && (
                  <>
                    {' '}
                    See our <a href="/privacy.html">privacy page</a> for
                    details.
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="final">
      <div class="wrap">
        <div>
          <h2>Build your shortlist.</h2>
          <p>
            Read the profiles, check the sources, then call two or three
            realtors and compare.
          </p>
        </div>
        <a class="btn" href="#directory">
          See all {agents.length} realtors
        </a>
      </div>
    </section>
  </main>
</Base>
